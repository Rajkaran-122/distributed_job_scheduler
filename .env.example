# Copy this file to .env and fill in real values before running docker compose.
#   cp .env.example .env

# PostgreSQL password (used by both the postgres container and the backend's datasource URL)
DB_PASSWORD=changeme

# Must be at least 32 characters (256 bits) -- JwtTokenProvider refuses to start otherwise.
# Generate a real one with: openssl rand -base64 48
JWT_SECRET=replace_with_a_random_256_bit_minimum_secret_string_value

# Number of concurrent job-handler threads per backend replica
WORKER_POOL_SIZE=10

# AI insight features: "none" (default, no LLM calls) or "anthropic"
AI_PROVIDER=none
AI_API_KEY=

# Grafana admin login password (username is always "admin")
GRAFANA_ADMIN_PASSWORD=admin
